    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/#Doctor -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/#Doctor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/#Person"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/#worksIn"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/ontologies/#Department"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/ontologies/#Patient"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/#MedicalRecord -->

